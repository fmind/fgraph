{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "excludes": [
    ".git",
    "**/node_modules",
    "**/*-lock.json",
    "python/.venv",
    "go/bin",
    "docs/public",
    "docs/resources",
    "docs/tmp",
    "conformance/cases/values/json-depth.json"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.22.1",
    "npm:@dprint/toml@0.8.0"
  ]
}
