{
  "name": "temporal/as-of-diff",
  "comment": "Time travel: at(tx) reconstructs past state via the visibility predicate (tx <= T AND (rx IS NULL OR rx > T)); diff returns what changed in a window. Allocation: 'ada'=65, 'person/city'=66, tx 67 then 68.",
  "steps": [
    { "tx": { "id": "ada", "person/city": "London" }, "expect": { "tx": 67, "...": true } },
    { "tx": { "id": "ada", "person/city": "Lyon" }, "expect": { "tx": 68, "...": true } },
    { "entity": "ada", "expect": { "person/city": "Lyon" } },
    {
      "at": 67,
      "steps": [
        { "entity": "ada", "expect": { "person/city": "London" } },
        {
          "history": ["ada", "person/city"],
          "expect": [
            {
              "id": 41,
              "e": "ada",
              "a": "person/city",
              "v": "London",
              "tx": 67,
              "rx": null,
              "at": 1767225601000000
            }
          ]
        },
        {
          "why": ["ada", "person/city"],
          "expect": [
            {
              "id": 41,
              "e": "ada",
              "a": "person/city",
              "v": "London",
              "tx": 67,
              "rx": null,
              "provenance": { "fgraph/at": { "instant": "2026-01-01T00:00:01.000000Z" } }
            }
          ]
        },
        {
          "q": { "find": ["?c"], "where": [["ada", "person/city", "?c"]] },
          "expect": { "columns": ["?c"], "rows": [["London"]] }
        },
        {
          "diff": [67, 68],
          "expect": { "asserted": [], "retracted": [] }
        },
        {
          "diff": [64, 68],
          "expect": {
            "asserted": [
              {
                "id": 40,
                "e": 67,
                "a": "fgraph/at",
                "v": { "instant": "2026-01-01T00:00:01.000000Z" },
                "tx": 67,
                "rx": null
              },
              {
                "id": 41,
                "e": "ada",
                "a": "person/city",
                "v": "London",
                "tx": 67,
                "rx": null
              }
            ],
            "retracted": []
          }
        },
        {
          "at": 68,
          "steps": [{ "entity": "ada", "expect": { "person/city": "London" } }]
        }
      ]
    },
    {
      "diff": [67, 68],
      "expect": {
        "asserted": [
          {
            "id": 42,
            "e": 68,
            "a": "fgraph/at",
            "v": { "instant": "2026-01-01T00:00:02.000000Z" },
            "tx": 68,
            "rx": null
          },
          { "id": 43, "e": "ada", "a": "person/city", "v": "Lyon", "tx": 68, "rx": null }
        ],
        "retracted": [
          { "id": 41, "e": "ada", "a": "person/city", "v": "London", "tx": 67, "rx": 68 }
        ]
      }
    }
  ]
}
