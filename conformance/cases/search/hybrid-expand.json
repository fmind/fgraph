{
  "name": "search/hybrid-expand",
  "comment": "Keyword and semantic candidates fuse at entity level, filters apply before the limit, and bidirectional reference expansion reports neighbors.",
  "steps": [
    { "declare": { "attr": "note/embedding", "type": "vector", "dims": 2 } },
    { "declare": { "attr": "note/related", "ref": true, "many": true } },
