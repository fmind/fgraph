      "tx": {
        "id": "note-a",
        "note/embedding": { "vector": [1.0, 0.0] },
        "note/kind": "guide",
        "note/related": { "ref": "note-b" },
        "note/text": "small composable tools"
      }
    },
    {
      "tx": {
        "id": "note-b",
        "note/embedding": { "vector": [0.0, 1.0] },
        "note/kind": "reference",
        "note/text": "large integrated framework"
      }
    },
    {
      "search": {
        "text": "composable tools",
        "vector": [1.0, 0.0],
        "k": 1,
