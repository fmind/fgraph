      }
    },
    {
      "search": {
        "vector": [1.0, 0.0],
        "k": 3,
        "vector_attribute": "note/embedding"
      },
      "expect": {
        "hits": [
          { "entity": "note-a", "...": true },
          { "entity": "note-b", "...": true }
