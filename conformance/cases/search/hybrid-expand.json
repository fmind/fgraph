        "expanded": [],
        "...": true
      }
    },
    {
      "tx": {
        "id": "undeclared-vector",
        "raw/embedding": { "vector": [0.6, 0.8] }
      }
    },
    {
      "search": {
        "vector": [0.6, 0.8],
        "k": 1,
        "vector_attribute": "raw/embedding"
      },
      "expect": {
        "hits": [{ "entity": "undeclared-vector", "...": true }],
