{
  "name": "transact/supersede-card-one",
  "comment": "Cardinality-one supersession: a new value retracts the old one in the same transaction, both moments are kept, and physical rows are byte-determined. Allocation: 'ada'=65, 'person/name'=66 (order of first appearance), tx last (67, then 68).",
  "steps": [
    { "tx": { "id": "ada", "person/name": "Ada" }, "expect": { "tx": 67, "ids": { "ada": 65 } } },
    { "tx": { "id": "ada", "person/name": "Ada L." }, "expect": { "tx": 68 } },
    {
      "q": { "find": ["?n"], "where": [["ada", "person/name", "?n"]] },
      "expect": { "columns": ["?n"], "rows": [["Ada L."]] }
    },
    { "entity": "ada", "expect": { "person/name": "Ada L." } },
    {
      "history": ["ada", "person/name"],
      "expect": [
        { "e": "ada", "a": "person/name", "v": "Ada", "tx": 67, "rx": 68, "...": "filled during M2" },
        { "e": "ada", "a": "person/name", "v": "Ada L.", "tx": 68, "rx": null, "...": "filled during M2" }
      ]
    },
    {
      "facts": true,
      "expect": [
        [26, 67, 1, 1767225601000000, 5, 67, null],
        [27, 65, 66, "Ada", 4, 67, 68],
        [28, 68, 1, 1767225602000000, 5, 68, null],
        [29, 65, 66, "Ada L.", 4, 68, null]
      ]
    }
  ]
}
